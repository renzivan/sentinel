{
  "name": "sentinel",
  "version": "1.0.0",
  "description": "AI-driven end-to-end testing — write flows in plain English; Sentinel drives your app with Claude + Playwright and reports functional, visual, console, and network issues.",
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta -k \"next dev\" \"tsx watch src/worker/index.ts\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@playwright/mcp": "^0.0.77",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.20",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
